.intro-title { font-size: 30rpx; font-weight: 800; color: #d69a36; margin-bottom: 10rpx; }
.intro-text { color:#82767d; font-size:26rpx; line-height:1.7; }
.photo-grid { display:grid; grid-template-columns: repeat(2, 1fr); gap: 20rpx; }
.photo-card { background:#fff; border-radius:22rpx; overflow:hidden; box-shadow:0 10rpx 32rpx rgba(190,114,88,.12); }
.photo-img { width:100%; height:230rpx; display:block; }
.photo-meta { padding:18rpx; }
.photo-title { font-size:28rpx; font-weight:700; color:#4b3d44; margin-bottom:8rpx; }
