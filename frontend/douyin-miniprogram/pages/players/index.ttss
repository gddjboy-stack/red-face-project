.round-card { margin-bottom: 22rpx; }
.round-title { font-size: 32rpx; font-weight: 800; color: #d69a36; margin-bottom: 10rpx; }
.round-text { color:#82767d; font-size:26rpx; line-height:1.7; }
.round-row { display:flex; align-items:center; gap:18rpx; margin-top:22rpx; color:#6f636a; font-size:26rpx; }
.round-input { flex:1; height:72rpx; padding:0 18rpx; background:#fff; border:2rpx solid rgba(214,154,54,.3); border-radius:14rpx; }
.mini-btn { width:150rpx; height:72rpx; line-height:72rpx; border-radius:14rpx; background:#d79a39; color:#fff; font-size:26rpx; }
.player-card { display:flex; align-items:center; gap:22rpx; padding:24rpx; margin-bottom:18rpx; border-radius:24rpx; background:rgba(255,255,255,.92); box-shadow:0 10rpx 32rpx rgba(190,114,88,.12); }
.player-cover { width:112rpx; height:112rpx; border-radius:22rpx; flex-shrink:0; }
.player-main { flex:1; min-width:0; }
.player-name { font-size:30rpx; font-weight:800; color:#4b3d44; margin-bottom:8rpx; }
.player-side { text-align:right; }
.side-tip { margin-top:8rpx; color:#9b8b92; font-size:24rpx; }
