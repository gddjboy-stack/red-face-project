<view class="container players-page">
  <view class="page-title">
    <text>选手</text>
    <text class="muted">按序号展示</text>
  </view>

  <view class="card round-card">
    <view class="round-title">{{roundName || '当前轮次'}}</view>
    <view class="round-text">选手按序号展示，当前人气值由直播互动数据实时更新。</view>
    <view class="round-row">
      <text>轮次 ID</text>
      <input class="round-input" type="number" value="{{roundId}}" placeholder="默认当前轮次" bindinput="onRoundInput" />
      <button class="mini-btn" bindtap="loadPlayers" loading="{{loading}}">刷新</button>
    </view>
  </view>

  <view tt:if="{{items.length === 0}}" class="card">
    <empty-state text="暂无选手数据" icon="◎" />
  </view>

  <view tt:else>
    <view class="player-card" tt:for="{{items}}" tt:key="playerId" bindtap="goDetail" data-player-id="{{item.playerId}}">
      <image tt:if="{{!item.imageError && item.photoPreviewUrl}}" class="player-cover safe-image" src="{{item.photoPreviewUrl}}" mode="aspectFill" binderror="onImageError" data-index="{{index}}" />
      <image tt:else class="player-cover safe-image" src="/assets/placeholders/photo_clean_stage.svg" mode="aspectFill" />
      <view class="player-main">
        <view class="player-name">{{item.number || '-'}}号 {{item.name}}</view>
        <view class="muted">{{item.teamName || '暂未分队'}}</view>
      </view>
      <view class="player-side">
        <view class="player-value">{{item.valueText}}</view>
        <view class="side-tip">查看</view>
      </view>
    </view>
  </view>
</view>
