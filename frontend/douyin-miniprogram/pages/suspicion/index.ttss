.suspicion-page {
  padding-bottom: 48rpx;
}

.intro-card {
  margin-top: 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3a2c32;
}

.state-tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f1e8eb;
  color: #8d858a;
  font-size: 24rpx;
}

.state-tag.active {
  background: #fff1d9;
  color: #b06d12;
}

.intro-text {
  margin-top: 18rpx;
  color: #5f5459;
  font-size: 28rpx;
  line-height: 1.7;
}

.intro-note {
  margin-top: 12rpx;
  color: #a08d96;
  font-size: 24rpx;
}

.message-card {
  margin: 18rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #fff8e8;
  color: #8a5a00;
  font-size: 26rpx;
  line-height: 1.6;
}

.empty-panel {
  margin-top: 18rpx;
  color: #8d858a;
  font-size: 28rpx;
  text-align: center;
}

.candidate-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 18rpx;
}

.candidate-card {
  padding: 24rpx;
  border: 2rpx solid #f1dfe5;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 10rpx 24rpx rgba(181, 96, 117, 0.08);
}

.candidate-card.selected,
.candidate-card.submitted {
  border-color: #d79a39;
  background: #fffaf1;
}

.candidate-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.candidate-name {
  display: block;
  color: #3a2c32;
  font-size: 32rpx;
  font-weight: 700;
}

.candidate-team {
  display: block;
  margin-top: 8rpx;
  color: #8d858a;
  font-size: 24rpx;
}

.choice-tag {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #d79a39;
  color: #fff;
  font-size: 24rpx;
}

.progress-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 22rpx;
}

.progress-track {
  flex: 1;
  height: 16rpx;
  border-radius: 999rpx;
  background: #f1e8eb;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #d79a39, #b85c70);
}

.progress-text {
  width: 150rpx;
  color: #8d858a;
  font-size: 24rpx;
  text-align: right;
}
