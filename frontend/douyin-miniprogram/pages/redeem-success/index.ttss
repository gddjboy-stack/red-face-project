.success-card { text-align: center; }
.success-icon { width: 108rpx; height: 108rpx; line-height: 108rpx; margin: 0 auto 22rpx; border-radius: 50%; background: #e7a341; color: #fff; font-size: 62rpx; font-weight: 800; }
.success-title { font-size: 34rpx; font-weight: 800; color: #d69a36; margin-bottom: 14rpx; }
.success-subtitle { color: #8d7f86; font-size: 26rpx; margin-bottom: 24rpx; }
.photo-preview { width: 100%; height: 360rpx; border-radius: 24rpx; margin-bottom: 22rpx; }
.info-row { display:flex; justify-content:space-between; align-items:center; padding:20rpx 0; border-bottom:2rpx solid rgba(214,154,54,.16); color:#6f636a; }
