<view class="container home-page">
  <view class="page-title">
    <view>
      <text>首页</text>
      <text class="brand-subtitle">红颜·局中局 LOVAL LEVEL</text>
    </view>
    <text class="muted">··· ⚙</text>
  </view>

  <view class="feature-card safe-image">
    <view class="feature-label">本周精选推送 ▶</view>
    <view class="feature-content">
      <text>NO.12 佳佳精彩任务记录</text>
    </view>
  </view>

  <view class="card live-card">
    <view class="row">
      <view>
        <text class="live-dot"></text>
        <text class="live-title">{{home.liveStatus === 'live' ? '活动进行中 · ' + (home.roundName || '') : '当前暂无进行中的活动'}}</text>
      </view>
      <text class="muted">···</text>
    </view>
    <view class="live-desc" tt:if="{{home.liveStatus === 'live'}}">活动进行中，敬请关注现场互动。</view>
    <view class="live-desc" tt:else>活动开始后信息将自动更新。</view>
    <view class="live-tip">* 相关互动请在活动现场参与</view>

    <view class="support-row">
      <text>信息更新时间</text>
      <text>{{updatedAtText}}</text>
    </view>
  </view>

  <button class="secondary-btn" bindtap="goRedeem">卡密核销</button>
  <button class="ghost-btn" bindtap="refreshHome" loading="{{loading}}">刷新当前数据</button>
</view>
