<view class="container home-page">
  <view class="page-title">
    <view>
      <text>首页</text>
      <text class="brand-subtitle">红颜·局中局 LOVAL LEVEL</text>
    </view>
    <text class="muted">··· ⚙</text>
  </view>

  <view class="feature-card safe-image">
    <view class="feature-label">本周精选推送 ▶</view>
    <view class="feature-content">
      <text>NO.12 佳佳精彩任务记录</text>
    </view>
  </view>

  <view class="card live-card">
    <view class="row">
      <view>
        <text class="live-dot"></text>
        <text class="live-title">{{home.liveStatus === 'live' ? '正在直播 · ' + (home.roundName || '') : '当前暂无直播互动'}}</text>
      </view>
      <text class="muted">···</text>
    </view>
    <view class="live-desc" tt:if="{{home.liveStatus === 'live'}}">当前互动计入：{{home.targetDisplayName || '待选择对象'}}</view>
    <view class="live-desc" tt:else>开播后数据将自动更新。</view>
    <view class="live-tip">* 增加人气值/留言请在直播间进行</view>

    <view class="support-row">
      <text>当前支持对象</text>
      <text>实时数据更新 {{updatedAtText}}</text>
    </view>
    <view class="metric-box">
      <text>{{home.targetDisplayName || '--'}}</text>
      <text class="number-strong">{{targetPopularityText}}</text>
    </view>
    <view class="metric-box muted-box">
      <text>{{home.teamDisplayName || '团队人气'}}</text>
      <text class="number-strong">{{teamPopularityText}}</text>
    </view>
  </view>

  <button class="secondary-btn" bindtap="goRedeem">卡密核销</button>
  <button class="ghost-btn" bindtap="refreshHome" loading="{{loading}}">刷新当前数据</button>
</view>
