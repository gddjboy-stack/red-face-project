page {
  min-height: 100%;
  background: #fff5f8;
  color: #3f353b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.container {
  min-height: 100vh;
  padding: 28rpx 28rpx 56rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #ffe4ee 0%, #fff7f2 54%, #ffffff 100%);
}

.page-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #4b3d44;
}

.brand-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  letter-spacing: 10rpx;
  color: rgba(74, 61, 68, 0.48);
}

.card {
  background: rgba(255, 255, 255, 0.86);
  border: 2rpx solid rgba(230, 163, 74, 0.28);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 52rpx rgba(190, 114, 88, 0.16);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.soft-card {
  background: rgba(255, 247, 240, 0.84);
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  margin: 22rpx 0 16rpx;
  text-shadow: 0 2rpx 6rpx rgba(160, 92, 58, 0.3);
}

.orange {
  color: #d79830;
}

.muted {
  color: #958a91;
}

.number-strong {
  color: #d69a36;
  font-size: 38rpx;
  font-weight: 800;
}

.primary-btn,
.secondary-btn,
.ghost-btn {
  width: 100%;
  border-radius: 18rpx;
  font-size: 30rpx;
  margin: 18rpx 0 0;
}

.primary-btn {
  background: linear-gradient(90deg, #e9aa47, #f2bd6d);
  color: #ffffff;
}

.secondary-btn {
  background: #ffffff;
  color: #d69a36;
  border: 2rpx solid rgba(214, 154, 54, 0.45);
}

.ghost-btn {
  background: rgba(255,255,255,0.72);
  color: #7f737b;
}

.empty-state,
.error-tip {
  padding: 60rpx 24rpx;
  text-align: center;
  color: #958a91;
  font-size: 28rpx;
}

.error-tip {
  color: #b54d4d;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #d69a36;
  font-size: 36rpx;
  font-weight: 800;
}

.input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  border: 2rpx solid rgba(214, 154, 54, 0.35);
  background: #ffffff;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #3f353b;
}

.safe-image {
  background: linear-gradient(135deg, #fff4d7, #ffdce8);
}
